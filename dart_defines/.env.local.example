# Copy this file to dart_defines/.env.local and set SUPABASE_ANON_KEY to the
# Supabase "anon"/"public" (publishable) key of PYLO's project.
#
# dart_defines/.env.local is git-ignored, so the key never enters version
# control. It is consumed by build_release_apk.ps1 (and a manual
# `--dart-define-from-file=dart_defines/.env.local`) through
# String.fromEnvironment('SUPABASE_ANON_KEY').
#
# Never put a service_role/secret key here - only the publishable anon key.
# Leave it empty to build a fully offline APK (cloud sync disabled).
SUPABASE_ANON_KEY=